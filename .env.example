# ==============================================================================
# TrulyLied Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# All external AI providers offer generous free tiers with zero credit card required.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM Infrastructure Providers
# ------------------------------------------------------------------------------
# Groq LPU API Key (Tier 1 Primary LLM & Whisper Large v3 Turbo Transcription)
# Obtain free at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Tier 2 Fallback LLM & VLM Visual Claim Extraction)
# Obtain free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Serper Google Search API Key (Web Evidence Retrieval)
# Obtain free (2,500 free queries) at: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# HuggingFace User Access Token (Tier 3 Cold Standby & RoBERTa/Toxic-BERT Models)
# Obtain free at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token_here

# ------------------------------------------------------------------------------
# 2. Database & Message Broker Services
# ------------------------------------------------------------------------------
# MongoDB Connection String (Local Docker or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/trulylied

# Redis URL (Broker for Celery, Pub/Sub WebSockets, and Distributed Token Bucket)
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database URL (Local Docker or Qdrant Cloud)
# If offline, the AI service automatically falls back to process-safe local storage.
QDRANT_URL=http://localhost:6333

# ------------------------------------------------------------------------------
# 3. Microservice Networking & Ports
# ------------------------------------------------------------------------------
# Node.js API Gateway Port
PORT=8080

# Python AI Service URL (used by Node.js orchestrator)
PYTHON_AI_URL=http://localhost:8000

# Next.js Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
